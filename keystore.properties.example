# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is gitignored — never commit real passwords.
#
# Generate a keystore with:
#   keytool -genkeypair -v \
#     -keystore ~/.android/smsforwarder-release.jks \
#     -alias smsforwarder -keyalg RSA -keysize 2048 -validity 10000
#
# Without keystore.properties the release build still runs, it just produces
# an unsigned APK.

storeFile=/absolute/path/to/smsforwarder-release.jks
storePassword=your-store-password
keyAlias=smsforwarder
keyPassword=your-key-password
